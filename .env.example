# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Meta WhatsApp Cloud API
# From Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta for Developers → your app → WhatsApp → Configuration → Webhook
# This is a string YOU choose; it must match what you enter in the dashboard.
WHATSAPP_VERIFY_TOKEN=

# Meta for Developers → your app → App Settings → Basic → App Secret
WHATSAPP_APP_SECRET=

# Supabase project URL and service-role key (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the cron service sends as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

PORT=3000
